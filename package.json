{
  "name": "merchant-portal",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --code-coverage",
    "e2e": "ng build && playwright test",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\" playwright.config.ts",
    "lint": "ng lint",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\" playwright.config.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "bootstrap": "^5.3.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.43",
    "@angular/cli": "^20.3.43",
    "@angular/compiler-cli": "^20.3.0",
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@vitest/coverage-v8": "^3.2.7",
    "angular-eslint": "20.7.0",
    "eslint": "^9.39.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.4",
    "vitest": "^3.2.7"
  }
}
